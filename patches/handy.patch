diff --git a/src-tauri/src/gtk_theme.rs b/src-tauri/src/gtk_theme.rs
new file mode 100644
index 0000000..7274694
--- /dev/null
+++ b/src-tauri/src/gtk_theme.rs
@@ -0,0 +1,48 @@
+use gtk::prelude::*;
+use std::cell::RefCell;
+use webkit2gtk::{
+    UserContentInjectedFrames, UserContentManagerExt, UserStyleLevel, UserStyleSheet, WebViewExt,
+};
+
+/// Follow GTK palette changes when the user selects the system theme.
+pub fn apply(view: &webkit2gtk::WebView) {
+    let Some(manager) = view.user_content_manager() else {
+        return;
+    };
+    let previous = RefCell::new(None);
+    let update = move |context: &gtk::StyleContext| {
+        let colors: String = [
+            ("background", "window_bg_color", "theme_bg_color"),
+            ("text", "window_fg_color", "theme_fg_color"),
+            (
+                "background-ui",
+                "accent_bg_color",
+                "theme_selected_bg_color",
+            ),
+            ("logo-primary", "accent_bg_color", "theme_selected_bg_color"),
+            ("logo-stroke", "accent_fg_color", "theme_selected_fg_color"),
+        ]
+        .into_iter()
+        .filter_map(|(token, name, fallback)| {
+            context
+                .lookup_color(name)
+                .or_else(|| context.lookup_color(fallback))
+                .map(|color| format!("--color-{token}: {color};"))
+        })
+        .collect();
+        let sheet = UserStyleSheet::new(
+            &format!(":root:not([data-theme]) {{ {colors} }}"),
+            UserContentInjectedFrames::TopFrame,
+            UserStyleLevel::Author,
+            &[],
+            &[],
+        );
+        if let Some(sheet) = previous.replace(Some(sheet.clone())) {
+            manager.remove_style_sheet(&sheet);
+        }
+        manager.add_style_sheet(&sheet);
+    };
+    let context = view.style_context();
+    update(&context);
+    context.connect_changed(update);
+}
