+static BOOL wayland_shm_buffer_clear_region(struct wayland_shm_buffer *buffer, HRGN region)
+{
+    RECT bounds = {0, 0, buffer->width, buffer->height}, rect;
+    RGNDATA *data = get_region_data(region);
+    const RECT *rects;
+    UINT i;
+    int y;
+
+    if (!data) return FALSE;
+    rects = (const RECT *)data->Buffer;
+    for (i = 0; i < data->rdh.nCount; ++i)
+    {
+        if (!intersect_rect(&rect, &bounds, &rects[i])) continue;
+        for (y = rect.top; y < rect.bottom; ++y)
+            memset((UINT32 *)buffer->map_data + y * buffer->width + rect.left,
+                   0, (rect.right - rect.left) * sizeof(UINT32));
+    }
+    free(data);
+    return TRUE;
+}
