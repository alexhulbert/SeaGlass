			<BelowZeroDecibel2 Value="#ffa519" />
			<Minimum Value="#ffa519" />
		</BipolarGainReductionVuMeter>
		<OrangeVuMeter>
			<OnlyMinimumToMaximum Value="true" />
			<Maximum Value="#ffa519" />
			<AboveZeroDecibel Value="#ffa519" />
			<ZeroDecibel Value="#ffa519" />
			<BelowZeroDecibel1 Value="#ffa519" />
			<BelowZeroDecibel2 Value="#ffa519" />
			<Minimum Value="#ffa519" />
		</OrangeVuMeter>
		<MainViewFocusIndicator Value="{{colors.on_surface_variant.default.hex}}" />
		<MidiEditorBlackKeyBackground Value="{{colors.surface_container_lowest.default.hex}}26" />
		<MidiEditorBackgroundWhiteKeySeparator Value="<* if {{is_dark_mode}} *>{{colors.surface_container_lowest.default.hex}}19<* else *>{{colors.outline.default.hex}}54<* endif *>" />
		<RangeEditField3 Value="<* if {{is_dark_mode}} *>#7b5732<* else *>#f1ac00<* endif *>" />
		<ScrollbarInnerHandleHover Value="{{colors.on_surface_variant.default.hex}}" />
		<ScrollbarInnerTrackHover Value="{{colors.surface.default.hex}}" />
		<ScrollbarLCDHandleHover Value="{{colors.on_surface_variant.default.hex}}" />
		<ScrollbarLCDTrackHover Value="{{colors.surface_container_highest.default.hex}}" />
		<ScrollbarMixerShowOnScrollHandleHover Value="#0000007f" />
		<RetroDisplayControlSelectionFrame Value="{{colors.outline_variant.default.hex}}" />
		<ThresholdLineColorHover Value="#5b8cff" />
		<SecondarySelectionForeground Value="#0000007f" />
	</Theme>
</Ableton>
